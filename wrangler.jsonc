{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ftrans-iranyitoszam-terkep-v3-test",
  "main": "src/index.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/__health", "/__version", "/data/*", "/vendor/*"]
  }
}
